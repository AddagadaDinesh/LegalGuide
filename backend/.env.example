# Default: free local model via Ollama (must be running: `ollama serve`)
OPENAI_API_KEY=ollama-local
OPENAI_MODEL=llama3
OPENAI_MAX_TOKENS=120
OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# To use real OpenAI instead: set OPENAI_API_KEY to a real key,
# OPENAI_MODEL to e.g. gpt-4o-mini, and leave OPENAI_BASE_URL blank.
